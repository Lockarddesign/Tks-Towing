---
// Self-hosted fonts — no external requests.
import '@fontsource-variable/archivo/wght.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import { business, meta } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title = meta.title, description = meta.description } = Astro.props;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  additionalType: 'https://schema.org/AutomotiveBusiness',
  name: business.name,
  description: meta.description,
  telephone: business.phone,
  foundingDate: String(business.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.state,
    postalCode: business.address.zip,
    addressCountry: 'US',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'Monday',
      'Tuesday',
      'Wednesday',
      'Thursday',
      'Friday',
      'Saturday',
      'Sunday',
    ],
    opens: '00:00',
    closes: '23:59',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Camden County, NJ' },
    { '@type': 'AdministrativeArea', name: 'Burlington County, NJ' },
    { '@type': 'AdministrativeArea', name: 'Gloucester County, NJ' },
  ],
  sameAs: business.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1219" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <set:html
      value={`<script type="application/ld+json">${JSON.stringify(localBusiness)}</script>`}
    />
  </head>
  <body
    class="bg-steel-950 font-sans text-steel-200 antialiased selection:bg-signal-400 selection:text-steel-950"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-signal-400 focus:px-5 focus:py-3 focus:font-semibold focus:text-steel-950"
      >Skip to content</a
    >

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <MobileCallBar />

    <script is:inline>
      // Reveal-on-scroll. Elements are visible by default; we only hide them
      // once we know JS is running AND the visitor has not asked for reduced
      // motion. No JS or reduced motion => everything renders statically.
      (() => {
        const reduced = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;
        const targets = document.querySelectorAll('[data-reveal]');
        if (reduced || !('IntersectionObserver' in window)) return;

        targets.forEach((el) => {
          el.style.opacity = '0';
        });

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target;
              const delay = Number(el.dataset.reveal) || 0;
              el.style.animation = `rise 0.7s cubic-bezier(0.22,1,0.36,1) ${delay}ms both`;
              io.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
        );

        targets.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
