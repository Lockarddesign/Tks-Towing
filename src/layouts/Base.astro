---
// Self-hosted fonts — no external requests.
import '@fontsource-variable/oswald/wght.css';
import '@fontsource-variable/libre-franklin/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import QuickActions from '../components/QuickActions.astro';
import QuoteDrawer from '../components/QuoteDrawer.astro';
import { business, meta } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  /** Pages without the homepage hero need the sticky header shown from the top. */
  pinnedHeader?: boolean;
}

const {
  title = meta.title,
  description = meta.description,
  pinnedHeader = false,
} = Astro.props;

// Keep in step with --color-navy-900 in src/styles/global.css.
const themeColor = '#0d1219';

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  additionalType: 'https://schema.org/AutomotiveBusiness',
  name: business.name,
  description: meta.description,
  telephone: business.phone,
  foundingDate: String(business.founded),
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.state,
    postalCode: business.address.zip,
    addressCountry: 'US',
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'Monday',
      'Tuesday',
      'Wednesday',
      'Thursday',
      'Friday',
      'Saturday',
      'Sunday',
    ],
    opens: '00:00',
    closes: '23:59',
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Camden County, NJ' },
    { '@type': 'AdministrativeArea', name: 'Burlington County, NJ' },
    { '@type': 'AdministrativeArea', name: 'Gloucester County, NJ' },
  ],
  sameAs: business.socials.map((s) => s.href),
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* set:html is a directive on a real element, never a tag of its own — as
        `<set:html value=... />` it emitted a literal <set:html> element, which
        swallowed <body> (losing its classes) and shipped the schema as escaped
        text instead of structured data. */}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(localBusiness)}
    />
  </head>
  <body
    class="bg-cream font-sans text-ink antialiased selection:bg-brick-500 selection:text-cream"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-full focus:bg-brick-500 focus:px-5 focus:py-3 focus:font-semibold focus:text-cream"
      >Skip to content</a
    >

    <Header pinned={pinnedHeader} />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <MobileCallBar />
    <QuickActions />
    <QuoteDrawer />

    <script is:inline>
      // Reveal-on-scroll. Elements are visible by default; we only hide them
      // once we know JS is running AND the visitor has not asked for reduced
      // motion. No JS or reduced motion => everything renders statically.
      (() => {
        const reduced = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;
        const targets = document.querySelectorAll('[data-reveal]');
        if (reduced || !('IntersectionObserver' in window)) return;

        targets.forEach((el) => {
          el.style.opacity = '0';
        });

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target;
              const delay = Number(el.dataset.reveal) || 0;
              el.style.animation = `rise 0.7s cubic-bezier(0.22,1,0.36,1) ${delay}ms both`;
              // Safety net: if the animation never runs for any reason, make sure
              // the element is still visible rather than stuck at opacity 0.
              el.addEventListener(
                'animationend',
                () => {
                  el.style.opacity = '';
                  el.style.animation = '';
                },
                { once: true }
              );
              window.setTimeout(() => {
                el.style.opacity = '';
              }, delay + 900);
              io.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 }
        );

        targets.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
