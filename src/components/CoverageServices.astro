---
/**
 * "What we run across the area" — the four services as icon boxes on /coverage,
 * each handing off to its full block on /services.
 *
 * The homepage sells these with photo cards; here they are compact icon boxes,
 * because on this page they are a checklist of what is available in your town,
 * not the main event. Copy is `services` verbatim.
 */
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { coveragePage } from '../site.config';

const { eyebrow, heading, intro, items } = coveragePage.services;
---

<section id="area-services" class="bg-cream py-20 sm:py-24 lg:py-28">
  <div class="mx-auto max-w-[81.25rem] px-5 sm:px-8">
    <SectionHead
      eyebrow={eyebrow}
      heading={heading}
      intro={intro}
      tone="light"
    />

    <ul class="mt-14 grid gap-5 sm:mt-16 sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((service, i) => (
          <li data-reveal={i * 70}>
            <a
              href={`/services#${service.slug}`}
              class="group flex h-full flex-col rounded-xl border border-line bg-paper p-7 transition-all duration-300 hover:-translate-y-1 hover:border-brick-500/35 hover:shadow-xl hover:shadow-navy-950/8"
            >
              <span class="grid h-12 w-12 place-items-center rounded-xl bg-brick-500/10 text-brick-500 transition-colors duration-300 group-hover:bg-brick-500 group-hover:text-cream">
                <Icon name={service.icon} class="h-6 w-6" />
              </span>

              <h3 class="mt-5 font-display text-lg leading-tight font-bold tracking-tight text-navy-700 uppercase sm:text-xl">
                {service.title}
              </h3>
              <p class="mt-2.5 text-[0.9rem] leading-relaxed text-ink/70">
                {service.summary}
              </p>

              {/* First two included items — the rest live on /services. */}
              <ul class="mt-5 space-y-2 border-t border-line pt-5">
                {service.bullets.slice(0, 2).map((bullet) => (
                  <li class="flex items-start gap-2 text-[0.85rem] text-ink/70">
                    <Icon
                      name="check"
                      class="mt-0.5 h-3.5 w-3.5 shrink-0 text-brick-500"
                    />
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>

              <span class="label-caps mt-auto flex items-center gap-2 pt-6 text-[0.65rem] text-brick-500 transition-all group-hover:gap-3">
                {service.title} details
                <Icon name="arrow" class="h-4 w-4" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
