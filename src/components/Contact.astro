---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import PlaceholderFigure from './PlaceholderFigure.astro';
import { business, contact } from '../site.config';
import mapImg from '../assets/chains-secured.jpg';

const inputClass =
  'mt-2 w-full rounded-xl border border-white/12 bg-steel-950/60 px-4 py-3.5 text-white placeholder:text-steel-500 transition focus:border-signal-400/60 focus:outline-2 focus:outline-offset-2 focus:outline-signal-400/40';
const labelClass =
  'block font-mono text-[0.65rem] tracking-[0.18em] text-steel-400 uppercase';
---

<section id="contact" class="bg-steel-900 py-24 sm:py-28 lg:py-36">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHead
      eyebrow={contact.eyebrow}
      heading={contact.heading}
      intro={contact.intro}
      tone="dark"
    />

    <div class="mt-16 grid gap-6 lg:mt-20 lg:grid-cols-12">
      <!-- Call panel + details -->
      <div class="flex flex-col gap-6 lg:col-span-5">
        <div
          data-reveal
          class="rounded-2xl border border-signal-400/25 bg-signal-400/6 p-7 sm:p-9"
        >
          <p
            class="font-mono text-[0.65rem] tracking-[0.2em] text-signal-400 uppercase"
          >
            {contact.callHeading}
          </p>
          <a
            href={business.phoneHref}
            class="mt-4 block font-display text-[clamp(2rem,6vw,3rem)] leading-none font-extrabold tracking-[-0.03em] text-white transition hover:text-signal-300"
          >
            {business.phone}
          </a>
          <p class="mt-4 text-sm text-steel-300">{contact.callNote}</p>
          <a
            href={business.phoneHref}
            class="mt-7 flex items-center justify-center gap-2.5 rounded-full bg-signal-400 px-6 py-4 font-display text-lg font-extrabold tracking-tight text-steel-950 transition hover:bg-signal-300"
          >
            <Icon name="phone" class="h-5 w-5" />
            Call now
          </a>
        </div>

        <div
          data-reveal="80"
          class="rounded-2xl border border-white/10 bg-steel-950/50 p-7 sm:p-9"
        >
          <dl class="space-y-7">
            <div>
              <dt class={labelClass}>{contact.detailsHeading}</dt>
              <dd class="mt-2.5 flex items-start gap-3 text-steel-200">
                <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-signal-400" />
                <address class="text-[0.95rem] leading-relaxed not-italic">
                  {business.address.street}<br />
                  {business.address.city}, {business.address.state}
                  {business.address.zip}
                </address>
              </dd>
            </div>
            <div>
              <dt class={labelClass}>{contact.hoursHeading}</dt>
              <dd class="mt-2.5 flex items-start gap-3 text-steel-200">
                <Icon
                  name="clock"
                  class="mt-0.5 h-5 w-5 shrink-0 text-signal-400"
                />
                <span class="text-[0.95rem] leading-relaxed">
                  {business.hours}
                </span>
              </dd>
            </div>
            <div>
              <dt class={labelClass}>{contact.socialHeading}</dt>
              <dd class="mt-3 flex flex-wrap gap-2">
                {
                  business.socials.map((social) => (
                    <a
                      href={social.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-full border border-white/12 px-4 py-2.5 text-sm text-steel-200 transition hover:border-signal-400/50 hover:text-white"
                    >
                      <Icon
                        name={social.label.toLowerCase()}
                        class="h-4 w-4 text-signal-400"
                      />
                      {social.label}
                    </a>
                  ))
                }
              </dd>
            </div>
          </dl>
        </div>

        <div data-reveal="140" class="overflow-hidden rounded-2xl border border-white/10">
          <PlaceholderFigure
            src={mapImg}
            label={contact.mapPlaceholder}
            class="aspect-16/9"
            sizes="(min-width: 1024px) 38vw, 100vw"
          />
        </div>
      </div>

      <!-- Quote form -->
      <div data-reveal="120" class="lg:col-span-7">
        <div
          class="h-full rounded-2xl border border-white/10 bg-steel-950/50 p-7 sm:p-10"
        >
          <h3
            class="font-display text-2xl font-extrabold tracking-tight text-white sm:text-3xl"
          >
            {contact.form.heading}
          </h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-steel-400">
            {contact.form.note}
          </p>

          <form
            class="mt-8 space-y-6"
            method="post"
            enctype="multipart/form-data"
          >
            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label class={labelClass} for="contact-name">
                  {contact.form.fields.name}
                </label>
                <input
                  class={inputClass}
                  id="contact-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                />
              </div>
              <div>
                <label class={labelClass} for="contact-email">
                  {contact.form.fields.email}
                </label>
                <input
                  class={inputClass}
                  id="contact-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                />
              </div>
            </div>

            <div>
              <label class={labelClass} for="contact-phone">
                {contact.form.fields.phone}
              </label>
              <input
                class={inputClass}
                id="contact-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
              />
            </div>

            <div>
              <label class={labelClass} for="contact-message">
                {contact.form.fields.message}
              </label>
              <textarea
                class={inputClass}
                id="contact-message"
                name="message"
                rows="5"
                placeholder={contact.form.fields.messagePlaceholder}
                required></textarea>
            </div>

            <div>
              <label class={labelClass} for="contact-files">
                {contact.form.fields.files}
              </label>
              <input
                class="mt-2 w-full rounded-xl border border-dashed border-white/15 bg-steel-950/60 px-4 py-3.5 text-sm text-steel-300 file:mr-4 file:rounded-full file:border-0 file:bg-white/8 file:px-4 file:py-2 file:font-sans file:text-sm file:text-white hover:file:bg-white/12"
                id="contact-files"
                name="files"
                type="file"
                multiple
              />
              <p class="mt-2 text-xs text-steel-500">
                {contact.form.fields.filesNote}
              </p>
            </div>

            <button
              type="submit"
              class="inline-flex w-full items-center justify-center gap-2.5 rounded-full bg-white px-8 py-4 font-display text-lg font-extrabold tracking-tight text-steel-950 transition hover:bg-signal-400 sm:w-auto"
            >
              {contact.form.submit}
              <Icon name="arrow" class="h-5 w-5" />
            </button>

            <p
              class="font-mono text-[0.65rem] leading-relaxed tracking-[0.12em] text-steel-500 uppercase"
            >
              {contact.form.disclaimer}
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
