---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { business, contact } from '../site.config';

interface Props {
  /** Off on /contact — that page's hero already carries this same copy. */
  showHead?: boolean;
}

const { showHead = true } = Astro.props;

const inputClass =
  'mt-2 w-full rounded-md border border-line bg-cream px-4 py-3.5 text-ink placeholder:text-ink/40 transition focus:border-brick-500/60 focus:bg-paper focus:outline-2 focus:outline-offset-2 focus:outline-brick-500/40';
const labelClass = 'label-caps block text-[0.65rem] text-navy-600';
---

<section id="contact" class="bg-paper py-24 sm:py-28 lg:py-36">
  <div class="mx-auto max-w-[81.25rem] px-5 sm:px-8">
    {
      showHead && (
        <SectionHead
          eyebrow={contact.eyebrow}
          heading={contact.heading}
          intro={contact.intro}
          tone="light"
        />
      )
    }

    <div
      class:list={[
        'grid gap-6 lg:grid-cols-12',
        showHead && 'mt-16 lg:mt-20',
      ]}
    >
      <!-- Call panel + details -->
      <div class="flex flex-col gap-6 lg:col-span-5">
        <div data-reveal class="rounded-xl bg-navy-800 p-7 sm:p-9">
          <p class="label-caps text-[0.65rem] text-brick-300">
            {contact.callHeading}
          </p>
          <a
            href={business.phoneHref}
            class="mt-4 block font-display text-[clamp(2.25rem,6vw,3.25rem)] leading-none font-bold tracking-tight text-cream transition hover:text-brick-300"
          >
            {business.phone}
          </a>
          <p class="mt-4 text-sm text-navy-100">{contact.callNote}</p>
          <a
            href={business.phoneHref}
            class="mt-7 flex items-center justify-center gap-2.5 rounded-md bg-brick-500 px-6 py-4 font-display text-lg font-bold tracking-tight text-cream uppercase transition hover:bg-brick-600"
          >
            <Icon name="phone" class="h-5 w-5" />
            Call now
          </a>
        </div>

        <div
          data-reveal="80"
          class="rounded-xl border border-line bg-cream p-7 sm:p-9"
        >
          <dl class="space-y-7">
            <div>
              <dt class={labelClass}>{contact.detailsHeading}</dt>
              <dd class="mt-2.5 flex items-start gap-3 text-ink">
                <Icon name="pin" class="mt-0.5 h-5 w-5 shrink-0 text-brick-500" />
                <address class="text-[0.95rem] leading-relaxed not-italic">
                  {business.address.street}<br />
                  {business.address.city}, {business.address.state}
                  {business.address.zip}
                </address>
              </dd>
            </div>
            <div>
              <dt class={labelClass}>{contact.hoursHeading}</dt>
              <dd class="mt-2.5 flex items-start gap-3 text-ink">
                <Icon
                  name="clock"
                  class="mt-0.5 h-5 w-5 shrink-0 text-brick-500"
                />
                <span class="text-[0.95rem] leading-relaxed">
                  {business.hours}
                </span>
              </dd>
            </div>
            <div>
              <dt class={labelClass}>{contact.socialHeading}</dt>
              <dd class="mt-3 flex flex-wrap gap-2">
                {
                  business.socials.map((social) => (
                    <a
                      href={social.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-md border border-line bg-paper px-4 py-2.5 text-sm text-navy-700 transition hover:border-brick-500/50 hover:text-brick-500"
                    >
                      <Icon
                        name={social.label.toLowerCase()}
                        class="h-4 w-4 text-brick-500"
                      />
                      {social.label}
                    </a>
                  ))
                }
              </dd>
            </div>
          </dl>
        </div>

        <div
          data-reveal="140"
          class="overflow-hidden rounded-xl border border-line"
        >
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(`TK's Towing Service, ${business.address.full}`)}&output=embed`}
            title={`Map to TK's Towing, ${business.address.full}`}
            class="aspect-16/9 h-auto w-full border-0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen></iframe>
        </div>
      </div>

      <!-- Quote form -->
      <div data-reveal="120" class="lg:col-span-7">
        <div class="h-full rounded-xl border border-line bg-cream p-7 sm:p-10">
          <h3 class="font-display text-2xl font-bold tracking-tight text-navy-700 uppercase sm:text-3xl">
            {contact.form.heading}
          </h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-ink/70">
            {contact.form.note}
          </p>

          <form
            class="mt-8 space-y-6"
            method="post"
            enctype="multipart/form-data"
          >
            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label class={labelClass} for="contact-name">
                  {contact.form.fields.name}
                </label>
                <input
                  class={inputClass}
                  id="contact-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  required
                />
              </div>
              <div>
                <label class={labelClass} for="contact-email">
                  {contact.form.fields.email}
                </label>
                <input
                  class={inputClass}
                  id="contact-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                />
              </div>
            </div>

            <div>
              <label class={labelClass} for="contact-phone">
                {contact.form.fields.phone}
              </label>
              <input
                class={inputClass}
                id="contact-phone"
                name="phone"
                type="tel"
                autocomplete="tel"
              />
            </div>

            <div>
              <label class={labelClass} for="contact-message">
                {contact.form.fields.message}
              </label>
              <textarea
                class={inputClass}
                id="contact-message"
                name="message"
                rows="5"
                placeholder={contact.form.fields.messagePlaceholder}
                required></textarea>
            </div>

            <div>
              <label class={labelClass} for="contact-files">
                {contact.form.fields.files}
              </label>
              <input
                class="mt-2 w-full rounded-md border border-dashed border-line bg-cream px-4 py-3.5 text-sm text-ink/70 file:mr-4 file:rounded-md file:border-0 file:bg-navy-700/8 file:px-4 file:py-2 file:font-sans file:text-sm file:text-navy-700 hover:file:bg-navy-700/12"
                id="contact-files"
                name="files"
                type="file"
                multiple
              />
              <p class="mt-2 text-xs text-ink/55">
                {contact.form.fields.filesNote}
              </p>
            </div>

            <button
              type="submit"
              class="inline-flex w-full items-center justify-center gap-2.5 rounded-md bg-navy-700 px-8 py-4 font-display text-lg font-bold tracking-tight text-cream uppercase transition hover:bg-brick-500 sm:w-auto"
            >
              {contact.form.submit}
              <Icon name="arrow" class="h-5 w-5" />
            </button>

            {contact.form.disclaimer && (
              <p class="label-caps text-[0.6rem] leading-relaxed text-ink/50">
                {contact.form.disclaimer}
              </p>
            )}
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
