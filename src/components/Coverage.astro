---
import SectionHead from './SectionHead.astro';
import CoverageMap from './CoverageMap.astro';
import Icon from './Icon.astro';
import { coverage, business } from '../site.config';

interface Props {
  /** Off on /coverage — that page's hero already carries this same copy. */
  showHead?: boolean;
  /** Off on /coverage — the town index section there lists them in full. */
  showTowns?: boolean;
}

const { showHead = true, showTowns = true } = Astro.props;

// Slug ties each region card to its county on the map.
const regions = coverage.regions.map((region) => ({
  ...region,
  slug: region.name.split(' ')[0].toLowerCase(),
  isFull: region.status === 'Full coverage',
}));
---

<!-- overflow-clip, not overflow-hidden: hidden creates a scroll container and
     silently kills the sticky map column; clip crops the wash without it. -->
<section id="coverage" class="relative overflow-clip bg-paper py-16 sm:py-20 lg:py-24">
  <!-- faint vintage wash, matching the Services section -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 -left-48 h-[32rem] w-[32rem] rounded-full bg-navy-700/5 blur-3xl"
  >
  </div>

  <div class="mx-auto max-w-[81.25rem] px-5 sm:px-8">
    {
      showHead && (
        <SectionHead
          eyebrow={coverage.eyebrow}
          heading={coverage.heading}
          intro={coverage.intro}
          tone="light"
        />
      )
    }

    <div
      class:list={[
        'grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-14',
        showHead && 'mt-16 lg:mt-20',
      ]}
      data-coverage
    >
      <!-- Map -->
      <div data-reveal class="lg:sticky lg:top-28 lg:col-span-5">
        <div class="rounded-2xl border border-line bg-cream p-6 sm:p-8">
          <div class="flex items-start gap-3.5">
            <span
              class="mt-0.5 grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-brick-500/10 text-brick-500"
            >
              <Icon name="pin" class="h-5 w-5" />
            </span>
            <div>
              <p
                class="font-display text-xl leading-none font-bold tracking-tight text-navy-700 uppercase"
              >
                {coverage.primaryLabel}
              </p>
              <p class="mt-1.5 text-sm leading-relaxed text-ink/70">
                {coverage.primaryNote}
              </p>
            </div>
          </div>

          <div class="mt-7">
            <CoverageMap />
          </div>
        </div>

        <!-- Outside the area -->
        <div class="mt-6 rounded-2xl border border-line bg-navy-800 p-7 sm:p-8">
          <h3 class="font-display text-xl font-bold tracking-tight text-cream uppercase">
            {coverage.outsideHeading}
          </h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-navy-100">
            {coverage.outsideBody}
          </p>
          <a
            href={business.phoneHref}
            class="mt-6 inline-flex items-center gap-2.5 rounded-md bg-brick-500 px-6 py-3.5 font-display text-base font-bold tracking-tight text-cream uppercase transition hover:bg-brick-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brick-300"
          >
            <Icon name="phone" class="h-4 w-4" />
            {business.phone}
          </a>
        </div>
      </div>

      <!-- Regions -->
      <div data-reveal="120" class="flex flex-col gap-5 lg:col-span-7">
        {
          regions.map((region) => (
            <article
              data-region={region.slug}
              class:list={[
                'group rounded-2xl border bg-paper p-7 transition-colors duration-300 sm:p-8',
                region.isFull
                  ? 'border-brick-500/30 bg-brick-50/40'
                  : 'border-line hover:border-navy-700/25',
              ]}
            >
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2.5">
                <h3 class="font-display text-2xl leading-none font-bold tracking-tight text-navy-700 uppercase sm:text-3xl">
                  {region.name}
                </h3>
                <span
                  class:list={[
                    'label-caps rounded-full px-3 py-1 text-[0.6rem]',
                    region.isFull
                      ? 'bg-brick-500 text-cream'
                      : 'bg-navy-700/8 text-navy-600',
                  ]}
                >
                  {region.status}
                </span>
              </div>

              <p class="mt-3 text-[0.95rem] leading-relaxed text-ink/70">
                {region.note}
              </p>

              {showTowns && (
                <>
                  <ul class="mt-6 flex flex-wrap gap-2">
                    {region.towns.map((town) => (
                      <li
                        class:list={[
                          'rounded-md border px-3.5 py-2 text-sm transition-colors',
                          region.isFull
                            ? 'border-brick-500/20 bg-paper text-navy-700'
                            : 'border-line bg-cream text-navy-600',
                        ]}
                      >
                        {town}
                      </li>
                    ))}
                  </ul>

                  {region.townsNote && (
                    <p class="label-caps mt-5 text-[0.6rem] leading-relaxed text-ink/50">
                      {region.townsNote}
                    </p>
                  )}
                </>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // Hovering (or focusing) a region card lights its county on the map, and
  // vice versa. Purely an enhancement — the section reads fine without it.
  (function () {
    const root = document.querySelector('[data-coverage]');
    if (!root) return;

    const counties = Array.from(root.querySelectorAll<SVGPathElement>('[data-county]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-region]'));
    if (!counties.length || !cards.length) return;

    const light = (slug: string | null) => {
      counties.forEach((c) => c.classList.toggle('is-lit', c.dataset.county === slug));
      cards.forEach((card) =>
        card.classList.toggle('is-active', card.dataset.region === slug)
      );
    };

    const bind = (el: Element, slug: string) => {
      el.addEventListener('mouseenter', () => light(slug));
      el.addEventListener('mouseleave', () => light(null));
      el.addEventListener('focusin', () => light(slug));
      el.addEventListener('focusout', () => light(null));
    };

    cards.forEach((card) => bind(card, card.dataset.region!));
    counties.forEach((county) => bind(county, county.dataset.county!));
  })();
</script>

<style>
  /* Card highlight when its county is hovered on the map */
  [data-region].is-active {
    border-color: color-mix(in srgb, var(--color-brick-500) 45%, transparent);
    box-shadow: 0 10px 30px -12px rgba(44, 65, 94, 0.28);
  }
  [data-county] {
    cursor: pointer;
  }
</style>
