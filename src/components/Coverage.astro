---
import SectionHead from './SectionHead.astro';
import Accordion from './Accordion.astro';
import Icon from './Icon.astro';
import PlaceholderFigure from './PlaceholderFigure.astro';
import { coverage, business } from '../site.config';
import mapImg from '../assets/flatbed-rural-road.jpg';
---

<section id="coverage" class="bg-bone-100 py-24 sm:py-28 lg:py-36">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHead
      eyebrow={coverage.eyebrow}
      heading={coverage.heading}
      intro={coverage.intro}
      tone="light"
    />

    <div class="mt-16 grid gap-10 lg:mt-20 lg:grid-cols-12 lg:gap-14">
      <!-- Map -->
      <div data-reveal class="lg:col-span-5">
        <div
          class="relative overflow-hidden rounded-2xl border border-steel-900/10 bg-steel-900"
        >
          <PlaceholderFigure
            src={mapImg}
            label={coverage.mapPlaceholder}
            class="aspect-4/3"
            sizes="(min-width: 1024px) 40vw, 100vw"
            overlay={false}
          />
          <div
            class="pointer-events-none absolute inset-0 bg-steel-950/45"
          >
          </div>
          <div
            class="pointer-events-none absolute inset-0 grid place-items-center p-6 text-center"
          >
            <div>
              <Icon name="pin" class="mx-auto h-10 w-10 text-signal-400" />
              <p
                class="mt-4 font-display text-2xl font-extrabold tracking-tight text-white"
              >
                {coverage.primaryLabel}
              </p>
              <p class="mt-1.5 text-sm text-steel-300">
                {coverage.primaryNote}
              </p>
            </div>
          </div>
        </div>

        <div
          class="mt-6 rounded-2xl border border-steel-900/10 bg-white p-7"
        >
          <h3
            class="font-display text-xl font-extrabold tracking-tight text-steel-900"
          >
            {coverage.outsideHeading}
          </h3>
          <p class="mt-3 text-[0.95rem] leading-relaxed text-steel-600">
            {coverage.outsideBody}
          </p>
          <a
            href={business.phoneHref}
            class="mt-5 inline-flex items-center gap-2 font-display font-bold tracking-tight text-brand-500 transition hover:text-brand-600"
          >
            <Icon name="phone" class="h-4 w-4" />
            {business.phone}
          </a>
        </div>
      </div>

      <!-- Regions -->
      <div data-reveal="120" class="lg:col-span-7">
        <div
          class="divide-y divide-steel-900/10 border-y border-steel-900/10"
        >
          {
            coverage.regions.map((region, i) => (
              <Accordion tone="light" open={i === 0} class="border-0">
                <div slot="summary">
                  <div class="flex flex-wrap items-center gap-3">
                    <h3 class="font-display text-2xl leading-tight font-extrabold tracking-tight text-steel-900 sm:text-3xl">
                      {region.name}
                    </h3>
                    <span
                      class:list={[
                        'rounded-full px-3 py-1 font-mono text-[0.6rem] tracking-[0.14em] uppercase',
                        region.status === 'Full coverage'
                          ? 'bg-brand-500/12 text-brand-600'
                          : 'bg-steel-900/8 text-steel-600',
                      ]}
                    >
                      {region.status}
                    </span>
                  </div>
                  <p class="mt-2 text-[0.95rem] leading-relaxed text-steel-600">
                    {region.note}
                  </p>
                </div>

                <ul class="flex flex-wrap gap-2">
                  {region.towns.map((town) => (
                    <li class="rounded-full border border-steel-900/12 bg-white px-3.5 py-2 text-sm text-steel-700">
                      {town}
                    </li>
                  ))}
                </ul>
                {region.townsNote && (
                  <p class="mt-4 font-mono text-[0.65rem] leading-relaxed tracking-[0.1em] text-steel-500 uppercase">
                    {region.townsNote}
                  </p>
                )}
              </Accordion>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
