---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { business, hero } from '../site.config';
import heroImg from '../assets/hero-truck.jpg';
---

<section
  id="top"
  class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-navy-900"
>
  <!-- Full-bleed hero photo -->
  <div class="absolute inset-0 -z-10">
    <Image
      src={heroImg}
      alt={hero.imageAlt}
      widths={[800, 1280, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
      class="h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-navy-950/72"></div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/60 to-navy-950/25"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-r from-navy-950/90 via-navy-950/30 to-transparent"
    >
    </div>
  </div>

  <div
    class="mx-auto w-full max-w-7xl px-5 pt-28 pb-14 sm:px-8 lg:pt-32 lg:pb-20"
  >
    <p data-reveal class="label-caps flex items-center gap-3 text-xs text-brick-300 sm:text-sm">
      <span class="relative flex h-2 w-2">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brick-400 opacity-75"
        ></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-brick-400"
        ></span>
      </span>
      {hero.eyebrow}
    </p>

    <h1
      data-reveal="80"
      class="mt-6 max-w-4xl font-display text-[clamp(3rem,9vw,7rem)] leading-[0.92] font-bold tracking-tight text-cream uppercase text-balance"
    >
      {hero.heading}
    </h1>

    <p
      data-reveal="160"
      class="mt-7 max-w-xl text-lg leading-relaxed text-navy-100 text-pretty sm:text-xl"
    >
      {hero.sub}
    </p>

    <div
      data-reveal="240"
      class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center"
    >
      <a
        href={business.phoneHref}
        class="group inline-flex items-center justify-center gap-3 rounded-md bg-brick-500 px-8 py-5 font-display text-xl font-bold tracking-tight text-cream uppercase shadow-2xl shadow-navy-950/40 transition hover:bg-brick-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brick-300 sm:text-2xl"
      >
        <Icon name="phone" class="h-6 w-6" />
        {hero.primaryCta}
      </a>
      <a
        href={hero.secondaryCtaHref}
        class="inline-flex items-center justify-center gap-2 rounded-md border-2 border-cream/25 px-8 py-5 font-display text-lg font-bold tracking-tight text-cream uppercase transition hover:border-cream/50 hover:bg-cream/8"
      >
        {hero.secondaryCta}
        <Icon name="chevron" class="h-5 w-5" />
      </a>
    </div>

    <ul
      data-reveal="320"
      class="label-caps mt-12 flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-cream/15 pt-7 text-[0.7rem] text-navy-100 sm:gap-x-5 sm:text-xs"
    >
      {
        hero.trustLine.map((item, i) => (
          <>
            {i > 0 && (
              <li aria-hidden="true" class="text-brick-300">
                ★
              </li>
            )}
            <li>{item}</li>
          </>
        ))
      }
    </ul>
  </div>
</section>
