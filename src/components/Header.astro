---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { business, nav } from '../site.config';
import logo from '../assets/tks-logo.png';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-line/70 bg-cream/85 backdrop-blur-xl transition-all duration-300"
>
  <div
    class="mx-auto flex h-18 max-w-7xl items-center gap-4 px-5 sm:px-8 lg:h-20"
  >
    <!-- Logo -->
    <a href="#top" class="group flex shrink-0 items-center gap-3">
      <Image
        src={logo}
        alt="TK's Towing — fast, reliable, professional. Since 1996."
        widths={[80, 120, 160]}
        sizes="56px"
        loading="eager"
        class="h-12 w-auto lg:h-14"
      />
      <span class="hidden leading-none sm:block">
        <span
          class="block font-display text-xl font-bold tracking-tight text-navy-700 lg:text-2xl"
          >TK&rsquo;S TOWING</span
        >
        <span class="label-caps mt-1 block text-[0.6rem] text-brick-500"
          >Since 1996 · Haddon Twp, NJ</span
        >
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        nav.links.map((link) => (
          <a
            href={link.href}
            class="rounded-md px-4 py-2 text-sm font-semibold text-navy-700 transition-colors hover:bg-navy-700/6 hover:text-brick-500"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop call CTA -->
    <a
      href={business.phoneHref}
      class="ml-auto hidden items-center gap-2 rounded-md bg-brick-500 px-5 py-3 font-display text-sm font-bold tracking-tight text-cream uppercase shadow-sm transition hover:bg-brick-600 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-brick-500 lg:ml-4 lg:inline-flex"
    >
      <Icon name="phone" class="h-4 w-4" />
      {nav.callCta}
    </a>

    <!-- Mobile: call + menu -->
    <div class="ml-auto flex items-center gap-2 lg:hidden">
      <a
        href={business.phoneHref}
        class="inline-flex items-center gap-2 rounded-md bg-brick-500 px-4 py-2.5 font-display text-sm font-bold tracking-tight text-cream uppercase"
      >
        <Icon name="phone" class="h-4 w-4" />
        <span class="hidden sm:inline">Call</span>
        <span class="sr-only">{nav.callCta}</span>
      </a>
      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid h-11 w-11 place-items-center rounded-md border border-line text-navy-700 transition hover:bg-navy-700/6"
      >
        <Icon name="menu" class="h-6 w-6" />
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    hidden
    class="border-t border-line/70 bg-cream/98 backdrop-blur-xl lg:hidden"
  >
    <nav class="mx-auto max-w-7xl px-5 py-4 sm:px-8" aria-label="Mobile">
      <ul class="divide-y divide-line/70">
        {
          nav.links.map((link) => (
            <li>
              <a
                href={link.href}
                data-menu-link
                class="flex items-center justify-between py-4 font-display text-lg font-bold tracking-tight text-navy-700"
              >
                {link.label}
                <Icon name="arrow" class="h-5 w-5 text-brick-500" />
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={business.phoneHref}
        class="mt-4 flex items-center justify-center gap-2 rounded-md bg-brick-500 px-6 py-4 font-display text-base font-bold tracking-tight text-cream uppercase"
      >
        <Icon name="phone" class="h-5 w-5" />
        {nav.callCta}
      </a>
      <p class="label-caps mt-3 text-center text-xs text-navy-500">
        {business.hoursShort}
      </p>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    const setOpen = (open) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.hidden);
    });

    menu.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false);
    });

    // Solidify the header once the hero is behind it.
    const header = document.getElementById('site-header');
    const onScroll = () => {
      const scrolled = window.scrollY > 24;
      header.classList.toggle('bg-cream/95', scrolled);
      header.classList.toggle('shadow-lg', scrolled);
      header.classList.toggle('shadow-navy-950/10', scrolled);
      header.classList.toggle('border-line', scrolled);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
