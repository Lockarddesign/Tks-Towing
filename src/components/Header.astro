---
import Icon from './Icon.astro';
import { business, nav } from '../site.config';
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-steel-950/80 backdrop-blur-xl transition-colors duration-300"
>
  <div
    class="mx-auto flex h-18 max-w-7xl items-center gap-4 px-5 sm:px-8 lg:h-20"
  >
    <!-- Logo -->
    <a href="#top" class="group flex shrink-0 items-center gap-3">
      <span
        class="grid h-10 w-10 place-items-center rounded-lg border border-signal-400/40 bg-signal-400/10 font-display text-sm font-extrabold tracking-tight text-signal-400 lg:h-11 lg:w-11"
        >TK</span
      >
      <span class="hidden leading-none sm:block">
        <span
          class="block font-display text-lg font-extrabold tracking-tight text-white lg:text-xl"
          >TK&rsquo;S TOWING</span
        >
        <span
          class="mt-1 block font-mono text-[0.6rem] tracking-[0.2em] text-steel-400 uppercase"
          >Since 1996 · Haddon Twp, NJ</span
        >
      </span>
      <span class="sr-only">PLACEHOLDER — TK&rsquo;S TOWING LOGO</span>
    </a>

    <!-- Desktop nav -->
    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        nav.links.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-4 py-2 text-sm font-medium text-steel-300 transition-colors hover:bg-white/5 hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop call CTA -->
    <a
      href={business.phoneHref}
      class="ml-auto hidden items-center gap-2 rounded-full bg-signal-400 px-5 py-3 font-display text-sm font-bold tracking-tight text-steel-950 shadow-lg shadow-signal-500/20 transition hover:bg-signal-300 hover:shadow-signal-400/30 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-signal-300 lg:ml-4 lg:inline-flex"
    >
      <Icon name="phone" class="h-4 w-4" />
      {nav.callCta}
    </a>

    <!-- Mobile: call + menu -->
    <div class="ml-auto flex items-center gap-2 lg:hidden">
      <a
        href={business.phoneHref}
        class="inline-flex items-center gap-2 rounded-full bg-signal-400 px-4 py-2.5 font-display text-sm font-bold tracking-tight text-steel-950"
      >
        <Icon name="phone" class="h-4 w-4" />
        <span class="hidden sm:inline">Call</span>
        <span class="sr-only">{nav.callCta}</span>
      </a>
      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid h-11 w-11 place-items-center rounded-full border border-white/10 text-white transition hover:bg-white/5"
      >
        <Icon name="menu" class="h-6 w-6" />
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    hidden
    class="border-t border-white/5 bg-steel-950/98 backdrop-blur-xl lg:hidden"
  >
    <nav class="mx-auto max-w-7xl px-5 py-4 sm:px-8" aria-label="Mobile">
      <ul class="divide-y divide-white/5">
        {
          nav.links.map((link) => (
            <li>
              <a
                href={link.href}
                data-menu-link
                class="flex items-center justify-between py-4 font-display text-lg font-bold tracking-tight text-white"
              >
                {link.label}
                <Icon name="arrow" class="h-5 w-5 text-signal-400" />
              </a>
            </li>
          ))
        }
      </ul>
      <a
        href={business.phoneHref}
        class="mt-4 flex items-center justify-center gap-2 rounded-full bg-signal-400 px-6 py-4 font-display text-base font-extrabold tracking-tight text-steel-950"
      >
        <Icon name="phone" class="h-5 w-5" />
        {nav.callCta}
      </a>
      <p class="mt-3 text-center font-mono text-xs tracking-widest text-steel-400 uppercase">
        {business.hoursShort}
      </p>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    const setOpen = (open) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };

    toggle.addEventListener('click', () => {
      setOpen(menu.hidden);
    });

    menu.querySelectorAll('[data-menu-link]').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) setOpen(false);
    });

    // Solidify the header once the hero is behind it.
    const header = document.getElementById('site-header');
    const onScroll = () => {
      const scrolled = window.scrollY > 24;
      header.classList.toggle('bg-steel-950/95', scrolled);
      header.classList.toggle('shadow-2xl', scrolled);
      header.classList.toggle('shadow-black/40', scrolled);
      header.classList.toggle('border-white/10', scrolled);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
