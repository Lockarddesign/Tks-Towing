---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { business, emergency } from '../site.config';
import bandImg from '../assets/truck-silhouette.jpg';
---

<section
  class="relative isolate overflow-hidden bg-brick-600 py-24 sm:py-28 lg:py-32"
>
  <div class="absolute inset-0 -z-10">
    <Image
      src={bandImg}
      alt=""
      widths={[900, 1600, 2200]}
      sizes="100vw"
      class="h-full w-full object-cover object-center opacity-25"
    />
    <div class="absolute inset-0 bg-brick-700/75"></div>
    <div
      class="absolute inset-0 bg-gradient-to-b from-brick-800 via-brick-700/70 to-brick-800"
    >
    </div>
  </div>

  <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
    <p
      data-reveal
      class="label-caps inline-flex items-center gap-2.5 rounded-full border border-cream/25 bg-cream/8 px-4 py-2 text-[0.7rem] text-cream"
    >
      <span class="relative flex h-1.5 w-1.5">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cream opacity-75"
        ></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-cream"
        ></span>
      </span>
      {emergency.eyebrow}
    </p>

    <h2
      data-reveal="80"
      class="mt-7 font-display text-[clamp(2.5rem,7.5vw,5rem)] leading-[0.95] font-bold tracking-tight text-cream uppercase text-balance"
    >
      {emergency.heading}
    </h2>

    <p
      data-reveal="140"
      class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-cream/85 text-pretty"
    >
      {emergency.body}
    </p>

    <a
      data-reveal="200"
      href={business.phoneHref}
      class="mt-10 inline-flex items-center justify-center gap-3 rounded-md bg-cream px-8 py-6 font-display text-[clamp(1.35rem,4vw,2rem)] leading-none font-bold tracking-tight text-navy-800 uppercase shadow-2xl shadow-navy-950/40 transition hover:bg-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cream sm:px-12"
    >
      <Icon name="phone" class="h-7 w-7 shrink-0" />
      {emergency.cta}
    </a>

    <p data-reveal="260" class="label-caps mt-7 text-[0.7rem] text-cream/70">
      {emergency.note}
    </p>
  </div>
</section>
