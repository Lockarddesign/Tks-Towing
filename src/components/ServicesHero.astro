---
/**
 * /services page header. The same hero as the About page: a short split band
 * under the pinned sticky header, dark copy panel on the left and the quote
 * form on the right.
 *
 * Copy is `servicesPage.hero`, which is the homepage `services` block verbatim.
 * The jump list is not decoration: the footer and the homepage service cards
 * both link to /services#slug, so the anchors have a visible index here.
 */
import Icon from './Icon.astro';
import QuoteForm from './QuoteForm.astro';
import { servicesPage, business } from '../site.config';
---

<section id="top" class="bg-navy-950">
  <div class="grid lg:grid-cols-[1fr_44%] xl:grid-cols-[1fr_48%]">
    <!-- Copy panel -->
    <div
      class="px-5 pt-14 pb-10 sm:px-8 lg:py-24 lg:pb-24 lg:pl-[max(2rem,calc((100vw-1300px)/2))] xl:py-28"
    >
      <div class="mx-auto max-w-2xl lg:mx-0 lg:pr-12">
        <p class="label-caps flex items-center gap-3 text-xs text-brick-300">
          <span class="h-px w-8 bg-brick-300/60"></span>
          {servicesPage.hero.eyebrow}
        </p>

        <h1
          class="mt-5 font-display text-[clamp(2.2rem,4.6vw,3.6rem)] leading-[0.97] font-bold tracking-tight text-balance text-cream uppercase"
        >
          {servicesPage.hero.heading}
        </h1>

        <p class="mt-6 text-lg leading-relaxed text-pretty text-cream/85">
          {servicesPage.hero.lead}
        </p>

        <!-- Jump list -->
        <ul class="mt-8 flex flex-wrap gap-2.5">
          {
            servicesPage.items.map((service) => (
              <li>
                <a
                  href={`#${service.slug}`}
                  class="inline-flex items-center gap-2 border border-cream/22 px-4 py-2.5 font-display text-[0.72rem] font-semibold tracking-[0.1em] text-cream/80 uppercase transition hover:border-brick-300 hover:text-cream"
                >
                  <Icon name={service.icon} class="h-4 w-4 text-brick-300" />
                  {service.title}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={business.phoneHref}
            class="inline-flex items-center justify-center gap-2.5 bg-brick-500 px-7 py-4 font-display font-bold tracking-wider text-cream uppercase transition hover:bg-brick-600"
          >
            <Icon name="phone" class="h-[17px] w-[17px]" />
            {servicesPage.primaryCta}
          </a>
          <a
            href={servicesPage.secondaryCtaHref}
            class="inline-flex items-center justify-center gap-2.5 border border-cream/30 px-7 py-4 font-display font-bold tracking-wider text-cream uppercase transition hover:border-cream hover:bg-cream/8"
          >
            {servicesPage.secondaryCta}
            <Icon name="arrow" class="h-[17px] w-[17px]" />
          </a>
        </div>
      </div>
    </div>

    <!-- Quote form. No order swap: DOM order (headline, then form) is right on
         both — a form ahead of any context reads badly on mobile. -->
    <div
      class="px-5 pt-2 pb-16 sm:px-8 lg:py-24 lg:pr-[max(2rem,calc((100vw-1300px)/2))] lg:pl-4 xl:py-28"
    >
      <div class="mx-auto w-full max-w-lg lg:mx-0 lg:max-w-none">
        <QuoteForm idPrefix="services" />
      </div>
    </div>
  </div>
</section>
