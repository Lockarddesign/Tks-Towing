---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { business, footer } from '../site.config';
import logo from '../assets/tks-logo.png';
---

<footer class="border-t border-brick-700/40 bg-navy-900">
  <div class="mx-auto max-w-[1300px] px-5 py-16 sm:px-8 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <!-- Brand -->
      <div class="lg:col-span-4">
        <div class="flex items-center gap-4">
          <Image
            src={logo}
            alt="TK's Towing badge logo"
            widths={[96, 144, 192]}
            sizes="72px"
            class="h-18 w-auto"
          />
          <span
            class="font-display text-2xl font-bold tracking-tight text-cream uppercase"
            >TK&rsquo;S Towing</span
          >
        </div>
        <p class="mt-5 max-w-xs text-[0.95rem] leading-relaxed text-navy-200">
          {footer.tagline}
        </p>
        <p class="label-caps mt-5 text-[0.65rem] text-brick-300">
          {footer.meta}
        </p>
      </div>

      <!-- Link columns -->
      {
        footer.columns.map((column) => (
          <nav class="lg:col-span-2" aria-label={column.heading}>
            <h2 class="label-caps text-[0.65rem] text-brick-300">
              {column.heading}
            </h2>
            <ul class="mt-5 space-y-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[0.95rem] text-navy-100 transition hover:text-cream"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <!-- Contact column -->
      <div class="lg:col-span-2">
        <h2 class="label-caps text-[0.65rem] text-brick-300">
          {footer.contactHeading}
        </h2>
        <ul class="mt-5 space-y-4">
          <li>
            <a
              href={business.phoneHref}
              class="inline-flex items-center gap-2 font-display text-lg font-bold tracking-tight text-cream transition hover:text-brick-300"
            >
              <Icon name="phone" class="h-4 w-4 text-brick-300" />
              {business.phone}
            </a>
          </li>
          <li>
            <address class="text-[0.95rem] leading-relaxed text-navy-100 not-italic">
              {business.address.street}<br />
              {business.address.city}, {business.address.state}
              {business.address.zip}
            </address>
          </li>
          <li class="text-[0.95rem] text-navy-100">{business.hoursShort}</li>
          <li class="flex gap-2 pt-1">
            {
              business.socials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="grid h-10 w-10 place-items-center rounded-md border border-cream/15 text-navy-100 transition hover:border-brick-300/50 hover:text-brick-300"
                >
                  <Icon name={social.label.toLowerCase()} class="h-4 w-4" />
                  <span class="sr-only">{social.label}</span>
                </a>
              ))
            }
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-cream/12 pt-8 text-sm text-navy-300 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>{footer.copyright}</p>
      <p>
        <a
          href={footer.creditHref}
          target="_blank"
          rel="noopener noreferrer"
          class="transition hover:text-cream">{footer.credit}</a
        >
      </p>
    </div>
  </div>
</footer>
