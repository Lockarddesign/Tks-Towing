---
import Icon from './Icon.astro';
import PlaceholderFigure from './PlaceholderFigure.astro';
import { story } from '../site.config';
import ownerImg from '../assets/operator-blue-car.jpg';
import fireImg from '../assets/firefighter.jpg';
---

<section
  id="story"
  class="relative isolate overflow-hidden bg-steel-900 py-24 sm:py-28 lg:py-36"
>
  <!-- Warm ambient glow behind the story, hinting at the fire-service angle -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 -right-40 -z-10 h-[36rem] w-[36rem] rounded-full bg-signal-500/8 blur-3xl"
  >
  </div>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid gap-14 lg:grid-cols-12 lg:items-center lg:gap-16">
      <!-- Images -->
      <div data-reveal class="lg:col-span-5">
        <div class="relative">
          <PlaceholderFigure
            src={ownerImg}
            label={story.ownerImageCaption}
            alt={story.ownerImageAlt}
            class="aspect-4/5 rounded-2xl border border-white/10"
            sizes="(min-width: 1024px) 38vw, 100vw"
          />
          <PlaceholderFigure
            src={fireImg}
            label={story.secondaryImageCaption}
            class="absolute -right-4 -bottom-10 aspect-square w-40 rounded-2xl border-4 border-steel-900 shadow-2xl shadow-black/50 sm:-right-8 sm:w-52 lg:-right-12"
            sizes="220px"
            widths={[220, 440]}
          />
        </div>
      </div>

      <!-- Copy -->
      <div class="lg:col-span-7 lg:pl-6">
        <p
          data-reveal
          class="flex items-center gap-3 font-mono text-xs tracking-[0.22em] text-signal-400 uppercase"
        >
          <Icon name="flame" class="h-4 w-4" />
          {story.eyebrow}
        </p>

        <h2
          data-reveal="80"
          class="mt-5 font-display text-[clamp(2rem,5vw,3.5rem)] leading-[0.98] font-extrabold tracking-[-0.025em] text-white text-balance"
        >
          {story.heading}
        </h2>

        <div data-reveal="140" class="mt-8 space-y-5">
          {
            story.paragraphs.map((p) => (
              <p class="text-lg leading-relaxed text-steel-300 text-pretty">
                {p}
              </p>
            ))
          }
        </div>

        <blockquote
          data-reveal="200"
          class="mt-10 border-l-2 border-signal-400 pl-6 sm:pl-8"
        >
          <p
            class="font-display text-[clamp(1.5rem,3vw,2.25rem)] leading-[1.15] font-bold tracking-[-0.02em] text-white text-balance"
          >
            &ldquo;{story.pullQuote}&rdquo;
          </p>
          <footer
            class="mt-5 font-mono text-[0.7rem] leading-relaxed tracking-[0.14em] text-steel-400 uppercase"
          >
            {story.pullQuoteAttribution}
          </footer>
        </blockquote>

        <dl
          data-reveal="260"
          class="mt-12 grid gap-x-8 gap-y-6 border-t border-white/10 pt-8 sm:grid-cols-2"
        >
          {
            story.facts.map((fact) => (
              <div>
                <dt class="font-mono text-[0.65rem] tracking-[0.18em] text-steel-500 uppercase">
                  {fact.label}
                </dt>
                <dd class="mt-1.5 font-display text-lg font-bold tracking-tight text-white">
                  {fact.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
