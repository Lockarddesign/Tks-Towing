---
import Icon from './Icon.astro';
import PlaceholderFigure from './PlaceholderFigure.astro';
import { business, story } from '../site.config';
import ownerImg from '../assets/tk-owners.jpg';
---

<section
  id="story"
  class="relative isolate overflow-hidden bg-navy-800 py-24 sm:py-28 lg:py-36"
>
  <!-- Warm ambient glow behind the story, hinting at the fire-service angle -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 -right-40 -z-10 h-[36rem] w-[36rem] rounded-full bg-brick-500/12 blur-3xl"
  >
  </div>

  <div class="mx-auto max-w-[1300px] px-5 sm:px-8">
    <div class="grid gap-14 lg:grid-cols-12 lg:items-stretch lg:gap-16">
      <!-- Portrait: one image, matted, running the full height of the copy -->
      <div data-reveal class="lg:col-span-5">
        <div class="portrait relative h-full">
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -inset-3 rounded-2xl border border-brick-400/25 sm:-inset-4"
          ></span>

          <PlaceholderFigure
            src={ownerImg}
            label=""
            alt={story.ownerImageAlt}
            class="portrait-figure aspect-4/5 h-full rounded-xl border border-cream/12 lg:aspect-auto lg:min-h-[34rem]"
            imgClass="h-full w-full object-cover object-top"
            sizes="(min-width: 1024px) 38vw, 100vw"
          />

          <p class="portrait-badge">
            <span class="portrait-badge-year font-display">
              {business.founded}
            </span>
            <span class="portrait-badge-text label-caps">
              Est. · {business.address.city}, {business.address.state}
            </span>
          </p>
        </div>
      </div>

      <!-- Copy -->
      <div class="flex flex-col justify-center lg:col-span-7 lg:pl-6">
        <p data-reveal class="label-caps flex items-center gap-3 text-xs text-brick-300">
          <Icon name="flame" class="h-4 w-4" />
          {story.eyebrow}
        </p>

        <h2
          data-reveal="80"
          class="mt-5 font-display text-[clamp(2.25rem,5.5vw,4rem)] leading-[0.98] font-bold tracking-tight text-cream uppercase text-balance"
        >
          {story.heading}
        </h2>

        <div data-reveal="140" class="mt-8 space-y-5">
          {
            story.paragraphs.map((p) => (
              <p class="text-lg leading-relaxed text-navy-100 text-pretty">
                {p}
              </p>
            ))
          }
        </div>

        <blockquote
          data-reveal="200"
          class="mt-10 border-l-4 border-brick-400 pl-6 sm:pl-8"
        >
          <p
            class="font-display text-[clamp(1.6rem,3.2vw,2.5rem)] leading-[1.1] font-medium tracking-tight text-cream text-balance"
          >
            &ldquo;{story.pullQuote}&rdquo;
          </p>
          <footer class="label-caps mt-5 text-[0.7rem] leading-relaxed text-brick-300">
            {story.pullQuoteAttribution}
          </footer>
        </blockquote>

        <dl
          data-reveal="260"
          class="mt-12 grid gap-x-8 gap-y-6 border-t border-cream/12 pt-8 sm:grid-cols-2"
        >
          {
            story.facts.map((fact) => (
              <div>
                <dt class="label-caps text-[0.65rem] text-navy-300">
                  {fact.label}
                </dt>
                <dd class="mt-1.5 font-display text-lg font-bold tracking-tight text-cream uppercase">
                  {fact.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  /* The matted frame sits behind a single portrait; the figure stretches to
     whatever height the copy column ends up at on desktop. */
  .portrait-figure {
    box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.85);
  }

  /* Year plate, half-hanging off the bottom-left corner of the portrait. */
  .portrait-badge {
    position: absolute;
    bottom: 1.25rem;
    left: -0.75rem;
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.65rem 1.1rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(197, 151, 148, 0.35);
    background: rgba(17, 26, 38, 0.88);
    backdrop-filter: blur(6px);
    box-shadow: 0 18px 36px -18px rgba(0, 0, 0, 0.9);
  }
  .portrait-badge-year {
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-cream);
  }
  .portrait-badge-text {
    font-size: 0.6rem;
    color: var(--color-brick-300);
  }

  @media (min-width: 640px) {
    .portrait-badge {
      left: -1.25rem;
      bottom: 1.75rem;
    }
  }
</style>
