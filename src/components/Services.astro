---
import SectionHead from './SectionHead.astro';
import Accordion from './Accordion.astro';
import Icon from './Icon.astro';
import { services, business } from '../site.config';
---

<section id="services" class="relative bg-cream py-24 sm:py-28 lg:py-36">
  <div class="mx-auto max-w-[1300px] px-5 sm:px-8">
    <SectionHead
      eyebrow={services.eyebrow}
      heading={services.heading}
      intro={services.intro}
      tone="light"
    />

    <div class="mt-16 grid gap-5 lg:mt-20 lg:grid-cols-2">
      {
        services.items.map((service, i) => (
          <article
            data-reveal={i * 80}
            class="group/card relative overflow-hidden rounded-xl border border-line bg-paper px-6 shadow-sm transition-all duration-300 hover:border-brick-500/40 hover:shadow-md sm:px-8"
          >
            <span
              aria-hidden="true"
              class="absolute inset-y-0 left-0 w-1 bg-brick-500 opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"
            />
            <Accordion tone="light" class="border-0">
              <div slot="summary">
                <div class="flex items-start gap-5">
                  <span class="grid h-12 w-12 shrink-0 place-items-center rounded-lg border border-navy-700/15 bg-navy-700/6 text-navy-700 transition-colors duration-300 group-open:border-brick-500/40 group-open:bg-brick-500/8 group-open:text-brick-500">
                    <Icon name={service.icon} class="h-6 w-6" />
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-display text-2xl leading-tight font-bold tracking-tight text-navy-700 uppercase sm:text-[1.7rem]">
                      {service.title}
                    </h3>
                    <p class="mt-2 text-[0.95rem] leading-relaxed text-ink/60">
                      {service.summary}
                    </p>
                  </div>
                </div>
              </div>

              <div class="pl-0 sm:pl-17">
                <p class="text-[0.95rem] leading-relaxed text-ink/80">
                  {service.detail}
                </p>
                <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
                  {service.bullets.map((bullet) => (
                    <li class="flex items-start gap-2.5 text-sm text-ink/80">
                      <Icon
                        name="check"
                        class="mt-0.5 h-4 w-4 shrink-0 text-brick-500"
                      />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
                <a
                  href={`/services/${service.slug}/`}
                  class="label-caps mt-7 inline-flex items-center gap-2 text-[0.7rem] text-brick-500 transition hover:text-brick-600"
                >
                  {service.title} details
                  <Icon name="arrow" class="h-4 w-4" />
                </a>
              </div>
            </Accordion>
          </article>
        ))
      }
    </div>

    <div
      data-reveal
      class="mt-12 flex flex-col gap-6 rounded-xl border border-line bg-paper p-7 shadow-sm sm:flex-row sm:items-center sm:justify-between sm:p-9"
    >
      <p class="max-w-2xl text-sm leading-relaxed text-ink/70">
        {services.footnote}
      </p>
      <a
        href={business.phoneHref}
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-md bg-navy-700 px-6 py-3.5 font-display font-bold tracking-tight text-cream uppercase transition hover:bg-navy-800"
      >
        <Icon name="phone" class="h-4 w-4" />
        Ask us
      </a>
    </div>
  </div>
</section>
