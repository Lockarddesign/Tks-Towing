---
import SectionHead from './SectionHead.astro';
import Accordion from './Accordion.astro';
import Icon from './Icon.astro';
import { services, business } from '../site.config';
---

<section id="services" class="relative bg-steel-950 py-24 sm:py-28 lg:py-36">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <SectionHead
      eyebrow={services.eyebrow}
      heading={services.heading}
      intro={services.intro}
      tone="dark"
    />

    <div class="mt-16 grid gap-5 lg:mt-20 lg:grid-cols-2">
      {
        services.items.map((service, i) => (
          <article
            data-reveal={i * 80}
            class="group/card relative overflow-hidden rounded-2xl border border-white/10 bg-steel-900/60 px-6 transition-colors duration-300 hover:border-white/20 sm:px-8"
          >
            <span
              aria-hidden="true"
              class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-signal-400/50 to-transparent opacity-0 transition-opacity duration-300 group-hover/card:opacity-100"
            />
            <Accordion tone="dark" class="border-0">
              <div slot="summary">
                <div class="flex items-start gap-5">
                  <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl border border-signal-400/25 bg-signal-400/10 text-signal-400 transition-colors duration-300 group-open:border-signal-400/50 group-open:bg-signal-400/15">
                    <Icon name={service.icon} class="h-6 w-6" />
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-display text-2xl leading-tight font-extrabold tracking-tight text-white sm:text-[1.7rem]">
                      {service.title}
                    </h3>
                    <p class="mt-2 text-[0.95rem] leading-relaxed text-steel-400">
                      {service.summary}
                    </p>
                  </div>
                </div>
              </div>

              <div class="pl-0 sm:pl-17">
                <p class="text-[0.95rem] leading-relaxed text-steel-300">
                  {service.detail}
                </p>
                <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
                  {service.bullets.map((bullet) => (
                    <li class="flex items-start gap-2.5 text-sm text-steel-300">
                      <Icon
                        name="check"
                        class="mt-0.5 h-4 w-4 shrink-0 text-signal-400"
                      />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
                <a
                  href={`/services/${service.slug}/`}
                  class="mt-7 inline-flex items-center gap-2 font-mono text-[0.7rem] tracking-[0.16em] text-signal-400 uppercase transition hover:text-signal-300"
                >
                  {service.title} details
                  <Icon name="arrow" class="h-4 w-4" />
                </a>
              </div>
            </Accordion>
          </article>
        ))
      }
    </div>

    <div
      data-reveal
      class="mt-12 flex flex-col gap-6 rounded-2xl border border-white/10 bg-steel-900/40 p-7 sm:flex-row sm:items-center sm:justify-between sm:p-9"
    >
      <p class="max-w-2xl text-sm leading-relaxed text-steel-400">
        {services.footnote}
      </p>
      <a
        href={business.phoneHref}
        class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-white/8 px-6 py-3.5 font-display font-bold tracking-tight text-white transition hover:bg-signal-400 hover:text-steel-950"
      >
        <Icon name="phone" class="h-4 w-4" />
        Ask us
      </a>
    </div>
  </div>
</section>
