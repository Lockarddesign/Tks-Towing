---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * A stock placeholder image with a visible label, so nobody mistakes these
 * for the client's real photos. Swap `src` for a real TK's photo and set
 * `label` to '' to drop the badge.
 */
interface Props {
  src: ImageMetadata;
  label: string;
  alt?: string;
  class?: string;
  imgClass?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  overlay?: boolean;
}

const {
  src,
  label,
  alt = label,
  class: className = '',
  imgClass = 'h-full w-full object-cover',
  widths = [640, 960, 1400],
  sizes = '(min-width: 1024px) 50vw, 100vw',
  loading = 'lazy',
  overlay = true,
} = Astro.props;
---

<figure class:list={['relative overflow-hidden', className]}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    loading={loading}
    decoding={loading === 'eager' ? 'sync' : 'async'}
    class={imgClass}
  />
  {
    overlay && (
      <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-steel-950/70 via-transparent to-transparent" />
    )
  }
  {
    label && (
      <figcaption class="pointer-events-none absolute bottom-3 left-3 max-w-[calc(100%-1.5rem)] rounded-md border border-white/15 bg-steel-950/80 px-2.5 py-1.5 font-mono text-[0.6rem] leading-tight tracking-[0.12em] text-signal-300 uppercase backdrop-blur-sm">
        {label}
      </figcaption>
    )
  }
</figure>
