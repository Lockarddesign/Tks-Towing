---
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { whyUs } from '../site.config';
---

<section id="why" class="bg-cream py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-[81.25rem] px-5 sm:px-8">
    <SectionHead
      eyebrow={whyUs.eyebrow}
      heading={whyUs.heading}
      intro={whyUs.intro}
      tone="light"
    />

    <ul
      class="mt-16 grid gap-px overflow-hidden rounded-xl border border-line bg-line lg:mt-20 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        whyUs.items.map((item, i) => (
          <li
            data-reveal={i * 60}
            class="group bg-paper p-8 transition-colors duration-300 hover:bg-cream sm:p-10"
          >
            <span class="why-icon">
              <Icon name={item.icon} class="h-7 w-7" />
            </span>
            <h3 class="mt-6 font-display text-xl leading-tight font-bold tracking-tight text-navy-700 uppercase sm:text-2xl">
              {item.title}
            </h3>
            <p class="mt-3.5 text-[0.95rem] leading-relaxed text-ink/75">
              {item.body}
            </p>
            <span
              aria-hidden="true"
              class="mt-6 block h-0.5 w-10 bg-navy-700/25 transition-all duration-300 group-hover:w-20 group-hover:bg-brick-500"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Framed icon plate — brick line art at rest, solid brick on card hover. */
  .why-icon {
    display: grid;
    place-items: center;
    height: 3.25rem;
    width: 3.25rem;
    border-radius: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--color-brick-500) 30%, transparent);
    background: color-mix(in srgb, var(--color-brick-500) 7%, transparent);
    color: var(--color-brick-500);
    transition:
      background-color 0.35s var(--ease-out-soft),
      border-color 0.35s var(--ease-out-soft),
      color 0.35s var(--ease-out-soft),
      transform 0.35s var(--ease-out-soft);
  }
  .group:hover .why-icon {
    background: var(--color-brick-500);
    border-color: var(--color-brick-500);
    color: var(--color-cream);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .why-icon {
      transition: none;
    }
    .group:hover .why-icon {
      transform: none;
    }
  }
</style>
