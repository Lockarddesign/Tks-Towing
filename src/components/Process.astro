---
/**
 * How it works — editorial numbered timeline.
 *
 * Replaces the old four-column accordion: the step detail is short enough that
 * hiding it behind a disclosure cost more (four chevrons, four uneven columns)
 * than it saved. Everything is visible now, laid out as a rail of outlined
 * Oswald numerals with a sticky section head beside it on desktop.
 */
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { business, nav, process } from '../site.config';
---

<!-- overflow-clip, not overflow-hidden: hidden creates a scroll container and
     silently kills the sticky head column; clip crops the wash without it. -->
<section id="process" class="relative overflow-clip bg-paper py-24 sm:py-28 lg:py-36">
  <!-- faint brick wash anchoring the top-right corner -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 -right-40 h-[34rem] w-[34rem] rounded-full bg-brick-500/5 blur-3xl"
  ></span>

  <div class="relative mx-auto max-w-[81.25rem] px-5 sm:px-8">
    <div class="grid gap-16 lg:grid-cols-[minmax(0,21rem)_1fr] lg:gap-20">
      <!-- sticky head + call CTA -->
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHead
          eyebrow={process.eyebrow}
          heading={process.heading}
          intro={process.intro}
          tone="light"
        />

        <a
          data-reveal="120"
          href={business.phoneHref}
          class="mt-10 inline-flex items-center gap-3 rounded-md bg-brick-500 px-7 py-4 font-display text-lg font-bold tracking-tight text-cream uppercase shadow-lg shadow-brick-700/20 transition hover:bg-brick-600"
        >
          <Icon name="phone" class="h-5 w-5" />
          {nav.callCta}
        </a>
        <p class="label-caps mt-4 text-[0.65rem] text-ink/50">
          {business.hoursShort} · {business.yearsInBusiness}
        </p>
      </div>

      <!-- steps -->
      <ol class="steps relative">
        {
          process.steps.map((step, i) => (
            <li
              data-reveal={i * 90}
              class="step group relative grid grid-cols-[3.5rem_1fr] gap-x-6 border-t border-line py-9 first:border-t-0 first:pt-0 sm:grid-cols-[6rem_1fr] sm:gap-x-10 sm:py-11 lg:py-14"
            >
              <div class="flex flex-col items-center">
                <span class="step-num font-display" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="step-dot" aria-hidden="true" />
                <span class="step-rail" aria-hidden="true" />
              </div>

              <div class="min-w-0">
                <div class="flex items-center gap-3">
                  <Icon
                    name={step.icon}
                    class="h-5 w-5 shrink-0 text-brick-500"
                  />
                  <h3 class="font-display text-2xl leading-tight font-bold tracking-tight text-navy-700 uppercase sm:text-3xl">
                    {step.title}
                  </h3>
                </div>
                <p class="mt-3 font-display text-lg leading-snug font-semibold tracking-tight text-brick-500 uppercase sm:text-xl">
                  {step.summary}
                </p>
                <p class="mt-4 max-w-2xl leading-relaxed text-ink/75">
                  {step.detail}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  /* Outlined americana numerals — hollow at rest, they fill brick as the row
     is hovered or focused, so the eye tracks down the rail. */
  .step-num {
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-brick-400);
    transition:
      color 0.35s var(--ease-out-soft),
      -webkit-text-stroke-color 0.35s var(--ease-out-soft),
      transform 0.35s var(--ease-out-soft);
  }
  .step:hover .step-num,
  .step:focus-within .step-num {
    color: var(--color-brick-500);
    -webkit-text-stroke-color: var(--color-brick-500);
    transform: translateY(-2px);
  }

  /* Rail runs from under each numeral to the foot of its row, so the four
     steps read as one continuous track. It grows to fill whatever height the
     row's copy takes. */
  .step-dot {
    width: 6px;
    height: 6px;
    margin-top: 1.1rem;
    border-radius: 50%;
    background: var(--color-brick-400);
    transition: transform 0.35s var(--ease-out-soft);
  }
  .step:hover .step-dot,
  .step:focus-within .step-dot {
    transform: scale(1.6);
  }
  .step-rail {
    flex: 1;
    width: 1px;
    min-height: 1.5rem;
    margin-top: 0.5rem;
    background: linear-gradient(
      var(--color-brick-400),
      var(--color-line) 60%,
      transparent
    );
  }
  .step:last-child .step-rail {
    max-height: 3rem;
    background: linear-gradient(var(--color-line), transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .step-num,
    .step-dot {
      transition: none;
    }
  }
</style>
