---
/**
 * Icon strips for /coverage, sitting between the map and the town index.
 *
 * Two rows, both icon boxes in the homepage idiom:
 *  1. the three proof facts (established / availability / service area)
 *  2. the four pillars
 *
 * No new copy — `hero.proof` and `intro.pillars` verbatim, the same blocks the
 * homepage renders. Only the icon choices live in site.config.
 */
import Icon from './Icon.astro';
import { coveragePage } from '../site.config';

const { proof, pillars } = coveragePage.highlights;
---

<section class="bg-paper py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-[81.25rem] px-5 sm:px-8">
    <!-- Proof: three wide boxes -->
    <ul class="grid gap-5 sm:grid-cols-3">
      {
        proof.map((item, i) => (
          <li
            data-reveal={i * 70}
            class="flex items-start gap-4 rounded-xl border border-line bg-cream p-6 sm:p-7"
          >
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brick-500/10 text-brick-500">
              <Icon name={item.icon} class="h-6 w-6" />
            </span>
            <div>
              <p class="label-caps text-[0.6rem] text-navy-600">{item.label}</p>
              <p class="mt-1.5 font-display text-xl leading-none font-bold tracking-tight text-navy-700 uppercase sm:text-2xl">
                {item.value}
              </p>
              <p class="mt-2 text-[0.88rem] leading-relaxed text-ink/65">
                {item.note}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    <!-- Pillars: four tighter boxes -->
    <ul
      class="mt-5 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        pillars.map((pillar, i) => (
          <li data-reveal={i * 70} class="bg-paper p-6 sm:p-7">
            <span class="grid h-11 w-11 place-items-center rounded-lg border border-line bg-cream text-brick-500">
              <Icon name={pillar.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-5 font-display text-base leading-tight font-bold tracking-tight text-navy-700 uppercase sm:text-lg">
              {pillar.title}
            </h3>
            <p class="mt-2 text-[0.9rem] leading-relaxed text-ink/70">
              {pillar.text}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
