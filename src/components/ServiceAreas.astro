---
/**
 * "Where we run this service" — the three counties, scoped to a service page.
 *
 * Region names, statuses, notes and the intro are `coverage` verbatim; the only
 * new string is the heading in `servicePage.areas`. It exists because a service
 * page that never names a place is weak for local search, and because "does he
 * come out to me?" is the question right after "what does this cover?".
 *
 * Deliberately does NOT repeat the town index — /service-areas owns that, and
 * the CTA sends people there.
 */
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';
import { coverage, servicePage, business } from '../site.config';

const { heading, cta, ctaHref } = servicePage.areas;
---

<section class="bg-cream py-20 sm:py-24 lg:py-28">
  <div class="mx-auto max-w-[81.25rem] px-5 sm:px-8">
    <SectionHead
      eyebrow={coverage.eyebrow}
      heading={heading}
      intro={coverage.intro}
      tone="light"
    />

    <ul class="mt-14 grid gap-5 sm:mt-16 lg:grid-cols-3">
      {
        coverage.regions.map((region, i) => {
          const isFull = region.status === 'Full coverage';
          return (
            <li
              data-reveal={i * 80}
              class="flex h-full flex-col rounded-xl border border-line bg-paper p-7 sm:p-8"
            >
              <div class="flex items-center gap-3.5">
                <span
                  class:list={[
                    'grid h-11 w-11 shrink-0 place-items-center rounded-xl',
                    isFull
                      ? 'bg-brick-500/10 text-brick-500'
                      : 'border border-line bg-cream text-navy-500',
                  ]}
                >
                  <Icon name="map" class="h-5 w-5" />
                </span>
                <div>
                  <h3 class="font-display text-lg font-bold tracking-tight text-navy-700 uppercase">
                    {region.name}
                  </h3>
                  <p
                    class:list={[
                      'label-caps text-[0.58rem]',
                      isFull ? 'text-brick-500' : 'text-navy-500',
                    ]}
                  >
                    {region.status}
                  </p>
                </div>
              </div>

              <p class="mt-5 text-[0.92rem] leading-relaxed text-ink/70">
                {region.note}
              </p>
            </li>
          );
        })
      }
    </ul>

    <div
      data-reveal
      class="mt-8 flex flex-col gap-6 rounded-2xl bg-navy-800 p-8 sm:flex-row sm:items-center sm:justify-between sm:p-10"
    >
      <p class="max-w-2xl text-sm leading-relaxed text-navy-100">
        {coverage.outsideBody}
      </p>
      <div class="flex shrink-0 flex-wrap gap-3">
        <a
          href={business.phoneHref}
          class="inline-flex items-center justify-center gap-2.5 rounded-md bg-brick-500 px-6 py-3.5 font-display font-bold tracking-tight text-cream uppercase transition hover:bg-brick-600"
        >
          <Icon name="phone" class="h-4 w-4" />
          {business.phone}
        </a>
        <a
          href={ctaHref}
          class="inline-flex items-center justify-center gap-2.5 rounded-md border border-cream/30 px-6 py-3.5 font-display font-bold tracking-tight text-cream uppercase transition hover:border-cream hover:bg-cream/8"
        >
          {cta}
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</section>
