---
/**
 * Fixed (parallax) photo background with the brand overlay stack.
 *
 * Implemented as a position:fixed image inside a `clip-path: inset(0)` window
 * rather than `background-attachment: fixed`, which Safari on iOS either
 * ignores or scrolls in jerky steps. Touch and reduced-motion get the same
 * photo pinned normally.
 *
 * Drop it in as the first child of a `relative isolate` section.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** CSS object-position for the photo. */
  position?: string;
  /** 0–1 — how dark the navy floor sits over the photo. */
  strength?: number;
}

const { src, position = 'center 55%', strength = 0.82 } = Astro.props;
---

<div class="fixed-bg" aria-hidden="true">
  <div class="fixed-bg-layer">
    <Image
      src={src}
      alt=""
      widths={[900, 1600, 2200]}
      sizes="100vw"
      class="fixed-bg-img"
      style={`object-position:${position}`}
    />
  </div>
  <div class="fixed-bg-tint" style={`--floor:${strength}`}></div>
  <div class="fixed-bg-vignette"></div>
</div>

<style>
  .fixed-bg {
    position: absolute;
    inset: 0;
    z-index: -10;
    clip-path: inset(0);
    pointer-events: none;
  }
  .fixed-bg-layer {
    position: fixed;
    inset: 0;
    height: 100vh;
    width: 100%;
  }
  .fixed-bg-img {
    height: 100%;
    width: 100%;
    object-fit: cover;
  }

  /* Navy floor + brick top-light, so the photo reads as brand, not stock. */
  .fixed-bg-tint {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(17, 26, 38, var(--floor, 0.82)),
        rgba(26, 40, 57, calc(var(--floor, 0.82) * 0.88)) 45%,
        rgba(17, 26, 38, calc(var(--floor, 0.82) * 1.08))
      ),
      radial-gradient(
        90% 70% at 50% 0%,
        rgba(124, 78, 75, 0.55),
        transparent 65%
      );
  }
  .fixed-bg-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      75% 65% at 50% 50%,
      transparent 40%,
      rgba(0, 0, 0, 0.55)
    );
  }

  @media (hover: none), (prefers-reduced-motion: reduce) {
    .fixed-bg {
      clip-path: none;
    }
    .fixed-bg-layer {
      position: absolute;
      height: 100%;
    }
  }
</style>
