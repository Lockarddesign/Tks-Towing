---
/**
 * Inline stroke icons. No icon library, no runtime cost.
 * Every path is drawn on a 24x24 grid with a 1.5 stroke.
 */
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;

const paths: Record<string, string[]> = {
  // Flatbed tow truck — cab plus a tilted deck carrying a vehicle
  flatbed: [
    'M2 17h1.5m0 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0Zm10.5 0a2 2 0 1 0 4 0 2 2 0 0 0-4 0Zm-6.5 0h6.5m4 0H22v-4l-3-4h-3v8Z',
    'M2 13V6h11v7',
    'M4 9.5 13 6',
  ],
  // Roadside — a wrench crossed with a battery bolt
  roadside: [
    'M14.7 6.3a4 4 0 0 0 5.3 5.3l-7.8 7.8a2.1 2.1 0 0 1-3-3l7.8-7.8Z',
    'M8 3 5.5 7.5H8L6 12l4.5-5H8L9.5 3H8Z',
  ],
  // Long distance — route with pins
  distance: [
    'M6 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm0 0c0 3 3 3.5 3 6.5S6 21 6 21',
    'M18 21a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm0-5c0-3-3-3.5-3-6.5S18 3 18 3',
  ],
  // Light equipment — a small loader / crate on forks
  equipment: [
    'M3 20h18',
    'M5 20v-6h6v6',
    'M11 14V9h4l3 5v6',
    'M7 17h2',
  ],
  phone: [
    'M4.5 4h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L14 13l4 1.5v3a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 2.5 6.2 2 2 0 0 1 4.5 4Z',
  ],
  clock: ['M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z', 'M12 7v5l3.5 2'],
  shield: [
    'M12 3 5 6v5.5c0 4.2 2.9 7.6 7 9.5 4.1-1.9 7-5.3 7-9.5V6l-7-3Z',
    'M9 12.2l2.2 2.2L15.5 10',
  ],
  map: [
    'M9 4 3 6.5v14L9 18m0-14 6 2.5m-6-2.5v14m6-11.5 6-2.5v14L15 18m0-11.5V18m0 0-6-2.5',
  ],
  star: ['M12 3.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9-5.3-2.9-5.3 2.9 1.1-5.9L3.5 9.7l5.9-.8L12 3.5Z'],
  chevron: ['m6 9 6 6 6-6'],
  arrow: ['M4 12h16m0 0-6-6m6 6-6 6'],
  menu: ['M4 7h16M4 12h16M4 17h16'],
  close: ['m6 6 12 12M18 6 6 18'],
  pin: ['M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z', 'M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z'],
  flame: [
    'M12 3s5 4.2 5 8.5a5 5 0 0 1-10 0C7 9 9 7.5 9 7.5s0 2 1.5 2S12 6 12 3Z',
  ],
  check: ['m5 12.5 4.5 4.5L19 7'],
  facebook: ['M14.5 21v-8h2.7l.4-3h-3.1V8.2c0-.9.3-1.5 1.5-1.5H18V4.1A19 19 0 0 0 15.6 4C13.2 4 11.5 5.4 11.5 8v2H9v3h2.5v8'],
  yelp: [
    'M11 4.2 11 11l-4.6-2A1 1 0 0 1 6 7.4l4-3.6a.6.6 0 0 1 1 .4Z',
    'M11 13.6 8 17.9a.6.6 0 0 0 .5 1l3.4-.4a1 1 0 0 0 .9-1V14a.6.6 0 0 0-1.1-.4Z',
    'M14.4 12.9l4.8 1.1a.6.6 0 0 1 .3 1l-2.1 2.5a1 1 0 0 1-1.5 0l-1.9-3.6a.6.6 0 0 1 .4-1Z',
    'M14.4 10.7l3.6-2.6a.6.6 0 0 1 .9.5l.1 3.2a1 1 0 0 1-1.2 1l-3.2-.9a.6.6 0 0 1-.2-1.1Z',
  ],
};

const d = paths[name] ?? [];
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {d.map((p) => <path d={p} />)}
</svg>
