---
import SectionHead from './SectionHead.astro';
import Accordion from './Accordion.astro';
import Icon from './Icon.astro';
import { faq, business } from '../site.config';
---

<section id="faq" class="bg-cream py-24 sm:py-28 lg:py-36">
  <div class="mx-auto max-w-[81.25rem] px-5 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:col-span-4 lg:self-start">
        <SectionHead eyebrow={faq.eyebrow} heading={faq.heading} tone="light" />
        <div
          data-reveal="120"
          class="mt-10 rounded-xl border border-line bg-paper p-7 shadow-sm"
        >
          <p class="text-[0.95rem] leading-relaxed text-ink/75">
            Not seeing your question? Call and ask, a real person picks up
            during business hours.
          </p>
          <a
            href={business.phoneHref}
            class="mt-5 inline-flex items-center gap-2 rounded-md bg-brick-500 px-6 py-3.5 font-display font-bold tracking-tight text-cream uppercase transition hover:bg-brick-600"
          >
            <Icon name="phone" class="h-4 w-4" />
            {business.phone}
          </a>
        </div>
      </div>

      <div data-reveal class="lg:col-span-8">
        <div class="divide-y divide-line border-y border-line">
          {
            faq.items.map((item) => (
              <Accordion tone="light" class="border-0">
                <h3
                  slot="summary"
                  class="pr-2 font-display text-lg leading-snug font-bold tracking-tight text-navy-700 uppercase sm:text-xl"
                >
                  {item.q}
                </h3>
                <p class="max-w-2xl text-[0.95rem] leading-relaxed text-ink/75">
                  {item.a}
                </p>
              </Accordion>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
