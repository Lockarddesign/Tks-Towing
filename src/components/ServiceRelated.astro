---
/**
 * Cross-links from one service page to the other three, on a dark band.
 *
 * Card shape follows AboutWhy: hairline border over a faint sheen, ghost index
 * numeral, cyan icon chip, accent rule drawing in on hover.
 *
 * Copy is each service's own title and summary; `servicePage` supplies the
 * heading and the link label.
 */
import Icon from './Icon.astro';
import { servicePage } from '../site.config';

interface Props {
  /** The service being viewed — excluded from the list. */
  currentSlug: string;
  items: readonly {
    slug: string;
    icon: string;
    title: string;
    summary: string;
  }[];
}

const { currentSlug, items } = Astro.props;
const others = items.filter((item) => item.slug !== currentSlug);
---

<section class="rel">
  <span class="rel__glow" aria-hidden="true"></span>

  <div class="rel__inner">
    <h2 class="rel__heading font-display" data-reveal>
      {servicePage.relatedHeading}
    </h2>

    <ul class="rel__grid">
      {
        others.map((item, i) => (
          <li class="rel__card" data-reveal={i * 70}>
            <span class="rel__rule" aria-hidden="true" />
            <span class="rel__index" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>

            <span class="rel__icon">
              <Icon name={item.icon} class="h-6 w-6" />
            </span>

            <h3 class="rel__title font-display">
              {/* Stretched link: the whole card is the target, but only the
                  title is in the accessibility tree as the link text. */}
              <a href={`/services/${item.slug}/`} class="rel__link">
                {item.title}
              </a>
            </h3>
            <p class="rel__body">{item.summary}</p>

            <span class="rel__cta label-caps" aria-hidden="true">
              {servicePage.relatedCta}
              <Icon name="arrow" class="h-4 w-4" />
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-navy-950);
    padding-block: 4.5rem;
  }
  .rel__glow {
    position: absolute;
    inset-inline: 0;
    top: -10rem;
    z-index: -1;
    height: 30rem;
    pointer-events: none;
    background: radial-gradient(
      55% 60% at 50% 40%,
      color-mix(in srgb, var(--color-brick-300) 12%, transparent) 0%,
      transparent 70%
    );
  }
  .rel__inner {
    margin-inline: auto;
    max-width: 1300px;
    padding-inline: 1.25rem;
  }

  .rel__heading {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--color-cream);
  }

  .rel__grid {
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1.25rem;
  }

  .rel__card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding: 2rem 1.75rem 1.9rem;
    border-radius: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-cream) 11%, transparent);
    background:
      linear-gradient(
        160deg,
        color-mix(in srgb, var(--color-cream) 7%, transparent) 0%,
        color-mix(in srgb, var(--color-cream) 2%, transparent) 42%,
        transparent 100%
      ),
      var(--color-navy-900);
    transition:
      border-color 0.35s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
  }
  .rel__rule {
    position: absolute;
    top: 0;
    left: 0;
    height: 2px;
    width: 100%;
    transform: scaleX(0);
    transform-origin: left center;
    background: linear-gradient(
      to right,
      var(--color-brick-300),
      var(--color-brick-500)
    );
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .rel__card:hover,
  .rel__card:focus-within {
    border-color: color-mix(in srgb, var(--color-brick-300) 42%, transparent);
    transform: translateY(-4px);
    box-shadow: 0 20px 40px -20px rgb(8 11 15 / 0.85);
  }
  .rel__card:hover .rel__rule,
  .rel__card:focus-within .rel__rule {
    transform: scaleX(1);
  }

  .rel__index {
    position: absolute;
    top: 0.6rem;
    right: 1.1rem;
    font-family: var(--font-display);
    font-size: 4.25rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--color-cream) 7%, transparent);
    pointer-events: none;
    user-select: none;
  }

  .rel__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: 1.4rem;
    border-radius: 0.7rem;
    border: 1px solid color-mix(in srgb, var(--color-brick-300) 30%, transparent);
    background: color-mix(in srgb, var(--color-brick-300) 11%, transparent);
    color: var(--color-brick-300);
    transition:
      background-color 0.35s ease,
      border-color 0.35s ease;
  }
  .rel__card:hover .rel__icon,
  .rel__card:focus-within .rel__icon {
    border-color: color-mix(in srgb, var(--color-brick-300) 55%, transparent);
    background: color-mix(in srgb, var(--color-brick-300) 18%, transparent);
  }

  .rel__title {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: var(--color-cream);
  }
  .rel__link {
    color: inherit;
    text-decoration: none;
  }
  /* Whole card clickable without nesting the paragraph inside the anchor. */
  .rel__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .rel__link:focus-visible {
    outline: 2px solid var(--color-brick-300);
    outline-offset: 4px;
  }

  .rel__body {
    margin-top: 0.7rem;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--color-navy-100);
  }

  .rel__cta {
    margin-top: 1.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.65rem;
    color: var(--color-brick-300);
    transition: gap 0.3s ease;
  }
  .rel__card:hover .rel__cta,
  .rel__card:focus-within .rel__cta {
    gap: 0.9rem;
  }

  @media (min-width: 640px) {
    .rel {
      padding-block: 5.5rem;
    }
    .rel__inner {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .rel {
      padding-block: 6.5rem;
    }
    .rel__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rel__card,
    .rel__rule,
    .rel__icon,
    .rel__cta {
      transition: none;
    }
    .rel__card:hover,
    .rel__card:focus-within {
      transform: none;
    }
  }
</style>
