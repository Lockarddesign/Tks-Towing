---
interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  /** 'dark' sits on steel, 'light' sits on bone. */
  tone?: 'dark' | 'light';
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  heading,
  intro,
  tone = 'dark',
  align = 'left',
  class: className = '',
} = Astro.props;

const isDark = tone === 'dark';
---

<div
  data-reveal
  class:list={[
    'max-w-3xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
>
  {
    eyebrow && (
      <p
        class:list={[
          'flex items-center gap-3 font-mono text-xs tracking-[0.22em] uppercase',
          align === 'center' && 'justify-center',
          isDark ? 'text-signal-400' : 'text-brand-500',
        ]}
      >
        <span
          class:list={[
            'h-px w-8',
            isDark ? 'bg-signal-400/60' : 'bg-brand-500/40',
          ]}
        />
        {eyebrow}
      </p>
    )
  }
  <h2
    class:list={[
      'mt-5 font-display text-[clamp(2rem,5vw,3.5rem)] leading-[0.98] font-extrabold tracking-[-0.02em] text-balance',
      isDark ? 'text-white' : 'text-steel-900',
    ]}
  >
    {heading}
  </h2>
  {
    intro && (
      <p
        class:list={[
          'mt-6 text-lg leading-relaxed text-pretty sm:text-xl',
          isDark ? 'text-steel-300' : 'text-steel-600',
        ]}
      >
        {intro}
      </p>
    )
  }
</div>
