---
interface Props {
  eyebrow?: string;
  heading: string;
  intro?: string;
  /** 'dark' sits on navy, 'light' sits on cream/paper. */
  tone?: 'dark' | 'light';
  align?: 'left' | 'center';
  class?: string;
}

const {
  eyebrow,
  heading,
  intro,
  tone = 'light',
  align = 'left',
  class: className = '',
} = Astro.props;

const isDark = tone === 'dark';
---

<div
  data-reveal
  class:list={[
    'max-w-3xl',
    align === 'center' && 'mx-auto text-center',
    className,
  ]}
>
  {
    eyebrow && (
      <p
        class:list={[
          'label-caps flex items-center gap-3 text-xs',
          align === 'center' && 'justify-center',
          isDark ? 'text-brick-300' : 'text-brick-500',
        ]}
      >
        <span
          class:list={[
            'h-px w-8',
            isDark ? 'bg-brick-300/60' : 'bg-brick-500/50',
          ]}
        />
        {eyebrow}
      </p>
    )
  }
  <h2
    class:list={[
      'mt-5 font-display text-[clamp(2.25rem,5.5vw,4rem)] leading-[0.98] font-bold tracking-tight text-balance uppercase',
      isDark ? 'text-cream' : 'text-navy-700',
    ]}
  >
    {heading}
  </h2>
  {
    intro && (
      <p
        class:list={[
          'mt-6 text-lg leading-relaxed text-pretty sm:text-xl',
          isDark ? 'text-navy-100' : 'text-ink/75',
        ]}
      >
        {intro}
      </p>
    )
  }
</div>
